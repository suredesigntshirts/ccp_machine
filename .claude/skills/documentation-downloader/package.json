{
  "name": "documentation-downloader",
  "version": "1.1.0",
  "description": "Claude Code skill — fetch external documentation and cache it locally as markdown",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm install && npm run install-browsers",
    "install-browsers": "npx playwright install --with-deps chromium chrome",
    "doctor": "node scripts/doctor.js",
    "test": "node --test scripts/test/*.test.mjs",
    "fetch": "node scripts/fetch-docs.js"
  },
  "dependencies": {
    "playwright": "^1.49.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
