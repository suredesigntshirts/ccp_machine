{
  "name": "documentation-downloader",
  "version": "2.0.0",
  "description": "Claude Code skill — cache external documentation verbatim as markdown, and search it by section",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm install && npm run install-browsers",
    "install-browsers": "npx playwright install --with-deps chromium",
    "doctor": "node scripts/doctor.js",
    "test": "node --test scripts/test/*.test.mjs",
    "docs": "node scripts/docs.mjs",
    "eval": "node eval/run.mjs",
    "search-eval": "node eval/search/run.mjs"
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.18.2",
    "@mixmark-io/domino": "^2.2.0",
    "playwright": "^1.49.0",
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "linkedom": "^0.18.12",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
