{
  "name": "budget-soft-limit-drain-halt",
  "description": "Past 80% of the daily slice the scheduler drains (in-flight items checkpoint); at the full slice it halts, and a finished item frees a slot that nothing takes.",
  "init": {
    "wipLimit": 2
  },
  "steps": [
    {"event":{"type":"ORCHESTRATOR_STARTED","actor":{"kind":"session","id":"orchestrator"},"source":{"kind":"cli","ref":"harness send"}},"id":"orchestrator-started","now":"2026-10-26T01:00:00Z"},
    {"event":{"type":"DAY_STARTED","sevenDay":0.3,"fiveHour":0,"sevenDayResetsAt":1,"at":"2026-10-26T01:00:00Z","actor":{"kind":"session","id":"orchestrator"},"source":{"kind":"cli","ref":"harness send"}},"to":"budget","now":"2026-10-26T01:00:00Z","expect":{"budget":"normal","scheduler":"accepting"}},
    {"event":{"type":"REQUEST_RECEIVED","request":{"id":"a"},"actor":{"kind":"session","id":"orchestrator"},"source":{"kind":"cli","ref":"harness send"}},"expect":{"inFlight":["a"]}},
    {"event":{"type":"REQUEST_RECEIVED","request":{"id":"b"},"actor":{"kind":"session","id":"orchestrator"},"source":{"kind":"cli","ref":"harness send"}},"expect":{"inFlight":["a","b"]}},
    {"event":{"type":"REQUEST_RECEIVED","request":{"id":"c"},"actor":{"kind":"session","id":"orchestrator"},"source":{"kind":"cli","ref":"harness send"}},"expect":{"effects":[],"queued":["c"],"items":{"c":"active.queued"}}},
    {"event":{"type":"USAGE_SAMPLED","sevenDay":0.385,"fiveHour":0.2,"sevenDayResetsAt":1,"at":"2026-10-26T06:00:00Z","actor":{"kind":"session","id":"orchestrator"},"source":{"kind":"cli","ref":"harness send"}},"to":"budget","now":"2026-10-26T06:00:00Z","expect":{"effects":["checkpoint","checkpoint"],"budget":"wrappingUp","scheduler":"draining"}},
    {"event":{"type":"USAGE_SAMPLED","sevenDay":0.4,"fiveHour":0.3,"sevenDayResetsAt":1,"at":"2026-10-26T08:00:00Z","actor":{"kind":"session","id":"orchestrator"},"source":{"kind":"cli","ref":"harness send"}},"to":"budget","now":"2026-10-26T08:00:00Z","expect":{"budget":"paused","scheduler":"halted"}},
    {"event":{"type":"TRIAGED","tier":0,"criteria":["a works"],"actor":{"kind":"session","id":"triager"},"source":{"kind":"cli","ref":"harness send"}},"to":"item:a","expect":{"effects":["dispatchRun:build"]}},
    {"event":{"type":"RUN_SUCCEEDED","actor":{"kind":"session","id":"worker"},"source":{"kind":"cli","ref":"harness send"}},"to":"item:a","expect":{"effects":["dispatchRun:verify"]}},
    {"event":{"type":"CHECKS_PASSED","actor":{"kind":"github","id":"github"},"source":{"kind":"github-wake","ref":"delivery-1"}},"to":"item:a","expect":{"effects":["mergePullRequest"]}},
    {"event":{"type":"MERGED","actor":{"kind":"github","id":"github"},"source":{"kind":"github-wake","ref":"delivery-2"}},"to":"item:a","expect":{"items":{"a":"done","c":"active.queued"},"inFlight":["b"],"queued":["c"],"scheduler":"halted"}}
  ]
}
