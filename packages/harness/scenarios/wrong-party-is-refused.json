{
  "name": "wrong-party-is-refused",
  "description": "Each gate takes its event only from the party the machine names: a worker's run, the person's tap, a GitHub wake. The same event from anyone else is refused and changes nothing.",
  "steps": [
    {"event":{"type":"ORCHESTRATOR_STARTED","actor":{"kind":"session","id":"orchestrator"},"source":{"kind":"cli","ref":"harness send"}},"id":"orchestrator-started"},
    {"event":{"type":"REQUEST_RECEIVED","request":{"id":"w","tier":2},"actor":{"kind":"session","id":"orchestrator"},"source":{"kind":"cli","ref":"harness send"}},"expect":{"effects":["dispatchRun:triage"]}},
    {"event":{"type":"RUN_SUCCEEDED","actor":{"kind":"session","id":"orchestrator"},"source":{"kind":"cli","ref":"harness send"}},"to":"item:w","expect":{"refused":"refused: RUN_SUCCEEDED in active.triaging","effects":[]}},
    {"event":{"type":"RUN_SUCCEEDED","actor":{"kind":"session","id":"worker"},"source":{"kind":"cli","ref":"harness send"}},"to":"item:w","expect":{"effects":["askStandIn"],"items":{"w":"active.awaitingPlanDecision"}}},
    {"event":{"type":"DECISION_MADE","choice":"approve","actor":{"kind":"session","id":"orchestrator"},"source":{"kind":"cli","ref":"harness send"}},"to":"item:w","expect":{"refused":"refused: DECISION_MADE in active.awaitingPlanDecision","items":{"w":"active.awaitingPlanDecision"}}},
    {"event":{"type":"STAND_IN_FAILED","actor":{"kind":"session","id":"orchestrator"},"source":{"kind":"cli","ref":"harness send"}},"to":"item:w/decision:w:plan:1","expect":{"effects":["postDecisionCard"],"needsPerson":true}},
    {"event":{"type":"PERSON_DECIDED","choice":"approve","actor":{"kind":"session","id":"orchestrator"},"source":{"kind":"cli","ref":"harness send"}},"to":"item:w/decision:w:plan:1","expect":{"refused":"refused: PERSON_DECIDED in awaitingPerson","needsPerson":true}},
    {"event":{"type":"PERSON_DECIDED","choice":"approve","actor":{"kind":"person","id":"person"},"source":{"kind":"tap","ref":""}},"to":"item:w/decision:w:plan:1","expect":{"refused":"refused: PERSON_DECIDED in awaitingPerson","needsPerson":true}},
    {"event":{"type":"PERSON_DECIDED","choice":"approve","actor":{"kind":"person","id":"person"},"source":{"kind":"tap","ref":"cmsg_card"}},"to":"item:w/decision:w:plan:1","expect":{"effects":["logPrecedent","dispatchRun:build"],"items":{"w":"active.building"},"needsPerson":false}},
    {"event":{"type":"RUN_SUCCEEDED","actor":{"kind":"session","id":"worker"},"source":{"kind":"cli","ref":"harness send"}},"to":"item:w","expect":{"effects":["dispatchRun:verify"]}},
    {"event":{"type":"CHECKS_PASSED","actor":{"kind":"session","id":"orchestrator"},"source":{"kind":"cli","ref":"harness send"}},"to":"item:w","expect":{"refused":"refused: CHECKS_PASSED in active.verifying","items":{"w":"active.verifying"}}},
    {"event":{"type":"CHECKS_PASSED","actor":{"kind":"github","id":"github"},"source":{"kind":"github-wake","ref":"delivery-1"}},"to":"item:w","expect":{"effects":["askStandIn"],"items":{"w":"active.awaitingAcceptance"}}}
  ]
}
