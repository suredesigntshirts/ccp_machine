{
  "name": "stand-in-reversal-demotes-class",
  "description": "The person rejects a plan the stand-in leaned to approve: the item is cancelled and the plan class drops from recommend to shadow.",
  "steps": [
    {"event":{"type":"ORCHESTRATOR_STARTED","actor":{"kind":"session","id":"orchestrator"},"source":{"kind":"cli","ref":"harness send"}},"id":"orchestrator-started"},
    {"event":{"type":"REQUEST_RECEIVED","request":{"id":"r","tier":2},"actor":{"kind":"session","id":"orchestrator"},"source":{"kind":"cli","ref":"harness send"}},"expect":{"effects":["dispatchRun:triage"],"standin":{"plan":"recommend"}}},
    {"event":{"type":"RUN_SUCCEEDED","actor":{"kind":"session","id":"worker"},"source":{"kind":"cli","ref":"harness send"}},"to":"item:r","expect":{"effects":["askStandIn"]}},
    {"event":{"type":"STAND_IN_ANSWERED","answer":{"choice":"approve","confidence":0.95},"actor":{"kind":"session","id":"stand-in"},"source":{"kind":"cli","ref":"harness send"}},"to":"item:r/decision:r:plan:1","expect":{"effects":["postDecisionCard"],"needsPerson":true}},
    {"event":{"type":"PERSON_DECIDED","choice":"reject","actor":{"kind":"person","id":"person"},"source":{"kind":"tap","ref":"cmsg_card"}},"to":"item:r/decision:r:plan:1","expect":{"effects":["logPrecedent"],"items":{"r":"cancelled"},"inFlight":[],"standin":{"plan":"shadow","accept":"recommend"}}}
  ]
}
