{
  "name": "revise-cannot-lower-the-tier",
  "description": "The person picks revise on a tier-2 plan: the item goes back to triage, a re-triage to tier 0 or 1 is refused and changes nothing, and one at tier 2 opens the plan gate again.",
  "steps": [
    {"event":{"type":"ORCHESTRATOR_STARTED","actor":{"kind":"session","id":"orchestrator"},"source":{"kind":"cli","ref":"harness send"}},"id":"orchestrator-started"},
    {"event":{"type":"REQUEST_RECEIVED","request":{"id":"r"},"actor":{"kind":"session","id":"orchestrator"},"source":{"kind":"cli","ref":"harness send"}},"expect":{"effects":["dispatchRun:triage"]}},
    {"event":{"type":"TRIAGED","tier":2,"criteria":["r works"],"actor":{"kind":"session","id":"triager"},"source":{"kind":"cli","ref":"harness send"}},"to":"item:r","expect":{"items":{"r":"active.awaitingPlanDecision"}}},
    {"event":{"type":"STAND_IN_ANSWERED","answer":{"choice":"revise","confidence":0.95},"actor":{"kind":"session","id":"stand-in"},"source":{"kind":"cli","ref":"harness answer"}},"to":"item:r/decision:r:plan:1","expect":{"needsPerson":true}},
    {"ack":"postDecisionCard","to":"item:r/decision:r:plan:1","card":"cmsg_card","by":{"actor":{"kind":"session","id":"orchestrator"},"source":{"kind":"cli","ref":"harness ack"}},"expect":{"effects":[]}},
    {"event":{"type":"PERSON_DECIDED","choice":"revise","actor":{"kind":"person","id":"person"},"source":{"kind":"tap","ref":"cmsg_card"}},"to":"item:r/decision:r:plan:1","expect":{"effects":["logPrecedent","dispatchRun:triage"],"items":{"r":"active.triaging"}}},
    {"event":{"type":"TRIAGED","tier":0,"criteria":["r works"],"actor":{"kind":"session","id":"triager-2"},"source":{"kind":"cli","ref":"harness send"}},"to":"item:r","expect":{"refused":"refused: TRIAGED in active.triaging","effects":[],"items":{"r":"active.triaging"}}},
    {"event":{"type":"TRIAGED","tier":1,"criteria":["r works"],"actor":{"kind":"session","id":"triager-2"},"source":{"kind":"cli","ref":"harness send"}},"to":"item:r","expect":{"refused":"refused: TRIAGED in active.triaging","effects":[],"items":{"r":"active.triaging"}}},
    {"event":{"type":"TRIAGED","tier":2,"criteria":["r works"],"actor":{"kind":"session","id":"triager-2"},"source":{"kind":"cli","ref":"harness send"}},"to":"item:r","expect":{"refused":null,"items":{"r":"active.awaitingPlanDecision"}}}
  ]
}
