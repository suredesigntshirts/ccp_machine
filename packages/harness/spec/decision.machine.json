{
  "id": "decision",
  "version": "0.1.0",
  "description": "One decision. The stand-in answers first; it decides alone only where its autonomy for this decision class is earned, otherwise the person decides on a card with its recommendation. Only a person's tap decides for the person: the machine checks that PERSON_DECIDED says actor person and source tap with the card's message id; that the tap is real is checked afterwards against the platform.",
  "initial": "askingStandIn",
  "context": {
    "id": "",
    "decisionClass": "",
    "tier": 2,
    "question": "",
    "options": [],
    "standIn": null,
    "choice": null,
    "decidedBy": null
  },
  "states": {
    "askingStandIn": {
      "entry": [
        {
          "type": "askStandIn"
        }
      ],
      "on": {
        "STAND_IN_ANSWERED": {
          "target": "routing",
          "actions": [
            {
              "type": "recordStandInAnswer"
            }
          ]
        },
        "STAND_IN_FAILED": {
          "target": "awaitingPerson"
        }
      }
    },
    "routing": {
      "always": [
        {
          "guard": {
            "type": "standInMayDecide"
          },
          "target": "decided",
          "actions": [
            {
              "type": "acceptStandInChoice"
            }
          ]
        },
        {
          "target": "awaitingPerson"
        }
      ]
    },
    "awaitingPerson": {
      "description": "A decision card is in front of the person, with the stand-in's recommendation.",
      "tags": [
        "needs-human"
      ],
      "entry": [
        {
          "type": "postDecisionCard"
        },
        {
          "type": "notifyInboxOpened"
        }
      ],
      "on": {
        "PERSON_DECIDED": [
          {
            "guard": {
              "type": "unattested",
              "params": {
                "actor": "person",
                "source": "tap"
              }
            },
            "description": "Refused unless the actor is a person and the source a tap whose ref is the decision card's message id. The machine checks the kinds and that the id is there; whether the tap happened is checked afterwards against the platform."
          },
          {
            "target": "decided",
            "actions": [
              {
                "type": "recordPersonChoice"
              }
            ]
          }
        ]
      }
    },
    "decided": {
      "type": "final",
      "entry": [
        {
          "type": "logPrecedent"
        },
        {
          "type": "reportDecision"
        },
        {
          "type": "notifyInboxClosed"
        }
      ]
    }
  }
}
