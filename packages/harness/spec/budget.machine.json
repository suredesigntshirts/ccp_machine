{
  "id": "budget",
  "version": "0.1.0",
  "description": "Spends a daily slice of the person's 7-day Claude usage window and watches the 5-hour window. Utilization values are 0..1 shares of each window. Today's spend (spentToday) accumulates per sample; when the 7-day window resets mid-day (sevenDayResetsAt changes or utilization drops) it counts on from 0. A TICK judges an old reading by the work done since, not by its age alone: with no reading, or one older than backstopMs (24h), it drains a normal budget to wrappingUp. A TICK that carries costSince (the dollars of ledger turns filed since the newest reading) projects today's spend as spentToday + costSince x costRate (7-day share per dollar, conservative by default) and drains only when that reaches the soft limit, so an idle harness keeps accepting on an old reading. A TICK without costSince keeps the plain age rule (staleAfterMs). A fresh reading lifts it.",
  "initial": "normal",
  "context": {
    "dailyShare": 0.1,
    "softAt": 0.8,
    "fiveHourStopAt": 0.95,
    "dayStartSevenDay": 0,
    "sevenDay": 0,
    "fiveHour": 0,
    "spentToday": 0,
    "sevenDayResetsAt": null,
    "staleAfterMs": 7200000,
    "backstopMs": 86400000,
    "costRate": 0.002,
    "sampledAt": null
  },
  "on": {
    "DAY_STARTED": [
      {
        "guard": {
          "type": "fiveHourExhausted"
        },
        "target": ".paused",
        "actions": [
          {
            "type": "startDay"
          }
        ]
      },
      {
        "target": ".normal",
        "actions": [
          {
            "type": "startDay"
          }
        ]
      }
    ],
    "CONFIGURE": {
      "actions": [
        {
          "type": "applyConfig"
        }
      ]
    }
  },
  "states": {
    "normal": {
      "description": "Work may start.",
      "entry": [
        {
          "type": "reportMode",
          "params": {
            "mode": "normal"
          }
        }
      ],
      "on": {
        "USAGE_SAMPLED": [
          {
            "guard": {
              "type": "mustPause"
            },
            "target": "paused",
            "actions": [
              {
                "type": "recordUsage"
              }
            ]
          },
          {
            "guard": {
              "type": "mustWrapUp"
            },
            "target": "wrappingUp",
            "actions": [
              {
                "type": "recordUsage"
              }
            ]
          },
          {
            "actions": [
              {
                "type": "recordUsage"
              }
            ]
          }
        ],
        "TICK": {
          "guard": {
            "type": "usageStale"
          },
          "target": "wrappingUp"
        }
      }
    },
    "wrappingUp": {
      "description": "Soft limit reached: start nothing new, bring work in flight to a checkpoint.",
      "entry": [
        {
          "type": "reportMode",
          "params": {
            "mode": "wrappingUp"
          }
        }
      ],
      "on": {
        "USAGE_SAMPLED": [
          {
            "guard": {
              "type": "mustPause"
            },
            "target": "paused",
            "actions": [
              {
                "type": "recordUsage"
              }
            ]
          },
          {
            "guard": {
              "type": "mayRun"
            },
            "target": "normal",
            "actions": [
              {
                "type": "recordUsage"
              }
            ]
          },
          {
            "actions": [
              {
                "type": "recordUsage"
              }
            ]
          }
        ]
      }
    },
    "paused": {
      "description": "Daily allowance spent or the 5-hour window nearly full: no turns except to save state.",
      "tags": [
        "budget-stop"
      ],
      "entry": [
        {
          "type": "reportMode",
          "params": {
            "mode": "paused"
          }
        }
      ],
      "on": {
        "USAGE_SAMPLED": [
          {
            "guard": {
              "type": "mayRun"
            },
            "target": "normal",
            "actions": [
              {
                "type": "recordUsage"
              }
            ]
          },
          {
            "guard": {
              "type": "mustWrapUp"
            },
            "target": "wrappingUp",
            "actions": [
              {
                "type": "recordUsage"
              }
            ]
          },
          {
            "actions": [
              {
                "type": "recordUsage"
              }
            ]
          }
        ]
      }
    }
  }
}
