{
  "id": "workItem",
  "version": "0.1.0",
  "description": "One thing moving through the pipeline: a change to one project of the monorepo, from request to merge. Runs and merges happen outside the machine; their results come back as events on later wakes. Run results come from a worker other than the orchestrator, whose id the harness passes in (orchestrator); each run's worker is recorded (workers), and both ids go to every decision the item opens, so neither can answer as the stand-in; CI and merge results come only from GitHub wakes, which from-github applies only after GitHub's REST API agrees. The machine checks actor and source kinds, that a ref is there, and that ids differ; who the sessions are is checked afterwards against the platform.",
  "initial": "active",
  "context": {
    "id": "",
    "project": "",
    "tier": 1,
    "criteria": [],
    "retries": 0,
    "runs": 0,
    "choice": null,
    "decisions": 0,
    "decisionId": null,
    "orchestrator": null,
    "workers": []
  },
  "on": {
    "CANCEL": {
      "target": ".cancelled"
    },
    "ORCHESTRATOR_STARTED": [
      {
        "guard": {
          "type": "fromOutside"
        },
        "description": "Sent by the harness when an orchestrator starts inside the harness; the same event from outside (any event with an actor) is refused."
      },
      {
        "actions": [
          {
            "type": "recordOrchestrator"
          }
        ]
      }
    ]
  },
  "states": {
    "active": {
      "initial": "queued",
      "on": {
        "BLOCK": {
          "target": "blocked"
        },
        "WRAP_UP": {
          "actions": [
            {
              "type": "checkpoint"
            }
          ]
        }
      },
      "states": {
        "queued": {
          "description": "Waiting for the scheduler to give it a slot.",
          "on": {
            "START": {
              "target": "triaging"
            }
          }
        },
        "triaging": {
          "description": "Scope, project, and acceptance criteria in the person's words.",
          "entry": [
            {
              "type": "dispatchRun",
              "params": {
                "step": "triage"
              }
            }
          ],
          "on": {
            "RUN_SUCCEEDED": [
              {
                "guard": {
                  "type": "reportedByOrchestrator"
                },
                "description": "Refused when the orchestrator reports the run itself, or no orchestrator is known yet: a run result comes from a worker, an actor other than the orchestrator. The machine compares the ids it is given; that the worker really ran is checked afterwards."
              },
              {
                "target": "planGate",
                "actions": [
                  {
                    "type": "recordRun"
                  }
                ]
              }
            ],
            "RUN_FAILED": [
              {
                "guard": {
                  "type": "reportedByOrchestrator"
                },
                "description": "Refused when the orchestrator reports the run itself, or no orchestrator is known yet: a run result comes from a worker, an actor other than the orchestrator. The machine compares the ids it is given; that the worker really ran is checked afterwards."
              },
              {
                "guard": {
                  "type": "retriesLeft",
                  "params": {
                    "max": 2
                  }
                },
                "target": "triaging",
                "reenter": true,
                "actions": [
                  {
                    "type": "countRetry"
                  }
                ]
              },
              {
                "target": "#workItem.failed"
              }
            ]
          }
        },
        "planGate": {
          "always": [
            {
              "guard": {
                "type": "tierBelow",
                "params": {
                  "tier": 1
                }
              },
              "target": "building"
            },
            {
              "target": "awaitingPlanDecision"
            }
          ]
        },
        "awaitingPlanDecision": {
          "tags": [
            "gated"
          ],
          "entry": [
            {
              "type": "openDecision",
              "params": {
                "gate": "plan"
              }
            }
          ],
          "on": {
            "DECISION_MADE": [
              {
                "guard": {
                  "type": "fromOutside"
                },
                "description": "Sent by the item's own decision when it is decided inside the harness; the same event from outside (any event with an actor) is refused."
              },
              {
                "guard": {
                  "type": "choiceIs",
                  "params": {
                    "choice": "approve"
                  }
                },
                "target": "building",
                "actions": [
                  {
                    "type": "recordChoice"
                  }
                ]
              },
              {
                "guard": {
                  "type": "choiceIs",
                  "params": {
                    "choice": "revise"
                  }
                },
                "target": "triaging",
                "actions": [
                  {
                    "type": "recordChoice"
                  }
                ]
              },
              {
                "target": "#workItem.cancelled",
                "actions": [
                  {
                    "type": "recordChoice"
                  }
                ]
              }
            ]
          },
          "exit": [
            {
              "type": "withdrawDecision"
            }
          ]
        },
        "building": {
          "description": "A worker thread builds on its own branch and opens a PR.",
          "entry": [
            {
              "type": "dispatchRun",
              "params": {
                "step": "build"
              }
            }
          ],
          "on": {
            "RUN_SUCCEEDED": [
              {
                "guard": {
                  "type": "reportedByOrchestrator"
                },
                "description": "Refused when the orchestrator reports the run itself, or no orchestrator is known yet: a run result comes from a worker, an actor other than the orchestrator. The machine compares the ids it is given; that the worker really ran is checked afterwards."
              },
              {
                "target": "verifying",
                "actions": [
                  {
                    "type": "recordRun"
                  }
                ]
              }
            ],
            "RUN_FAILED": [
              {
                "guard": {
                  "type": "reportedByOrchestrator"
                },
                "description": "Refused when the orchestrator reports the run itself, or no orchestrator is known yet: a run result comes from a worker, an actor other than the orchestrator. The machine compares the ids it is given; that the worker really ran is checked afterwards."
              },
              {
                "guard": {
                  "type": "retriesLeft",
                  "params": {
                    "max": 2
                  }
                },
                "target": "building",
                "reenter": true,
                "actions": [
                  {
                    "type": "countRetry"
                  }
                ]
              },
              {
                "target": "#workItem.failed"
              }
            ]
          }
        },
        "verifying": {
          "description": "CI, spec checks and a reviewer run against the acceptance criteria.",
          "entry": [
            {
              "type": "dispatchRun",
              "params": {
                "step": "verify"
              }
            }
          ],
          "on": {
            "CHECKS_PASSED": [
              {
                "guard": {
                  "type": "unattested",
                  "params": {
                    "actor": "github",
                    "source": "github-wake"
                  }
                },
                "description": "Refused unless a CI result comes from GitHub: actor github, source github-wake, with the GitHub fact as ref. The machine checks the kinds and that a ref is there; harness from-github sends it only after reading the PR from GitHub's REST API and finding the same result, which the ref names."
              },
              {
                "target": "acceptGate"
              }
            ],
            "CHECKS_FAILED": [
              {
                "guard": {
                  "type": "unattested",
                  "params": {
                    "actor": "github",
                    "source": "github-wake"
                  }
                },
                "description": "Refused unless a CI result comes from GitHub: actor github, source github-wake, with the GitHub fact as ref. The machine checks the kinds and that a ref is there; harness from-github sends it only after reading the PR from GitHub's REST API and finding the same result, which the ref names."
              },
              {
                "guard": {
                  "type": "retriesLeft",
                  "params": {
                    "max": 2
                  }
                },
                "target": "building",
                "actions": [
                  {
                    "type": "countRetry"
                  }
                ]
              },
              {
                "target": "#workItem.blocked"
              }
            ]
          }
        },
        "acceptGate": {
          "always": [
            {
              "guard": {
                "type": "tierBelow",
                "params": {
                  "tier": 1
                }
              },
              "target": "integrationGate"
            },
            {
              "target": "awaitingAcceptance"
            }
          ]
        },
        "awaitingAcceptance": {
          "description": "Evidence against each acceptance criterion: is the work doing what the person expected?",
          "tags": [
            "gated"
          ],
          "entry": [
            {
              "type": "openDecision",
              "params": {
                "gate": "accept"
              }
            }
          ],
          "on": {
            "DECISION_MADE": [
              {
                "guard": {
                  "type": "fromOutside"
                },
                "description": "Sent by the item's own decision when it is decided inside the harness; the same event from outside (any event with an actor) is refused."
              },
              {
                "guard": {
                  "type": "choiceIs",
                  "params": {
                    "choice": "approve"
                  }
                },
                "target": "integrationGate",
                "actions": [
                  {
                    "type": "recordChoice"
                  }
                ]
              },
              {
                "guard": {
                  "type": "choiceIs",
                  "params": {
                    "choice": "revise"
                  }
                },
                "target": "building",
                "actions": [
                  {
                    "type": "recordChoice"
                  }
                ]
              },
              {
                "target": "#workItem.cancelled",
                "actions": [
                  {
                    "type": "recordChoice"
                  }
                ]
              }
            ]
          },
          "exit": [
            {
              "type": "withdrawDecision"
            }
          ]
        },
        "integrationGate": {
          "always": [
            {
              "guard": {
                "type": "tierBelow",
                "params": {
                  "tier": 2
                }
              },
              "target": "merging"
            },
            {
              "target": "awaitingMergeDecision"
            }
          ]
        },
        "awaitingMergeDecision": {
          "description": "Merge to main: the person decides, the stand-in recommends.",
          "tags": [
            "gated"
          ],
          "entry": [
            {
              "type": "openDecision",
              "params": {
                "gate": "merge"
              }
            }
          ],
          "on": {
            "DECISION_MADE": [
              {
                "guard": {
                  "type": "fromOutside"
                },
                "description": "Sent by the item's own decision when it is decided inside the harness; the same event from outside (any event with an actor) is refused."
              },
              {
                "guard": {
                  "type": "choiceIs",
                  "params": {
                    "choice": "approve"
                  }
                },
                "target": "merging",
                "actions": [
                  {
                    "type": "recordChoice"
                  }
                ]
              },
              {
                "guard": {
                  "type": "choiceIs",
                  "params": {
                    "choice": "revise"
                  }
                },
                "target": "building",
                "actions": [
                  {
                    "type": "recordChoice"
                  }
                ]
              },
              {
                "target": "#workItem.cancelled",
                "actions": [
                  {
                    "type": "recordChoice"
                  }
                ]
              }
            ]
          },
          "exit": [
            {
              "type": "withdrawDecision"
            }
          ]
        },
        "merging": {
          "entry": [
            {
              "type": "mergePullRequest"
            }
          ],
          "on": {
            "MERGED": [
              {
                "guard": {
                  "type": "unattested",
                  "params": {
                    "actor": "github",
                    "source": "github-wake"
                  }
                },
                "description": "Refused unless a merge comes from GitHub: actor github, source github-wake, with the GitHub fact as ref. The machine checks the kinds and that a ref is there; harness from-github sends it only after reading the PR from GitHub's REST API and finding the same result, which the ref names."
              },
              {
                "target": "#workItem.done"
              }
            ],
            "MERGE_FAILED": {
              "target": "#workItem.blocked"
            }
          }
        },
        "hist": {
          "type": "history",
          "target": "queued"
        }
      }
    },
    "blocked": {
      "description": "Waiting on something outside the item (a dependency, a conflict, a failing check). Resumes where it stopped.",
      "entry": [
        {
          "type": "reportBlocked"
        }
      ],
      "on": {
        "UNBLOCKED": {
          "target": "active.hist"
        }
      }
    },
    "done": {
      "type": "final",
      "entry": [
        {
          "type": "reportFinished",
          "params": {
            "outcome": "done"
          }
        }
      ]
    },
    "failed": {
      "type": "final",
      "entry": [
        {
          "type": "reportFinished",
          "params": {
            "outcome": "failed"
          }
        }
      ]
    },
    "cancelled": {
      "type": "final",
      "entry": [
        {
          "type": "reportFinished",
          "params": {
            "outcome": "cancelled"
          }
        }
      ]
    }
  }
}
